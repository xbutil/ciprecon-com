                "border-radius": "0%"
              },
              ".mbr-section-title": {
                "margin": "0"
              }
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0"
              },
              "color": "#ddebfd"
            },
            ".social-wrapper": {
              "width": "100%"
            },
            ".social-row": {
