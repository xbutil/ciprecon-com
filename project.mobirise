              },
              "@media (max-width: 768px)": {
                "margin": "0 30px 30px"
              },
              ".mbr-section-title": {
                "margin": "0"
              },
              ".mbr-text": {
                "margin-top": "20px",
                "@media (max-width: 992px)": {
                  "margin-top": "12px"
                }
              }
            },
            ".client-wrapper": {
              "margin": "0 144px",
              "justify-content": "center",
              "@media (max-width: 992px)": {
                "margin": "0 18px"
              },
              ".card": {
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "height": "150px",
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "60px"
                },
                "@media (max-width: 768px)": {
                  "height": "auto",
                  "margin-bottom": "40px"
