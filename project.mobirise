                    "left": "0",
                    "width": "100%",
                    "height": "510px",
                    "object-fit": "cover",
                    "pointer-events": "visible"
                  }
                },
                ".card-wrap": {
                  "margin-top": "40px",
                  "display": "flex",
                  "transform": "translate(-36px, 0)",
                  "transition": "all .3s ease",
                  "@media (max-width: 992px)": {
                    "margin-top": "25px",
                    "transform": "none"
                  },
                  "span": {
                    "display": "flex",
                    "align-items": "center",
                    "font-size": "22px",
                    "margin-right": "12px",
                    "opacity": "0",
                    "transition": "all .4s ease",
                    "@media (max-width: 992px)": {
                      "opacity": "1"
                    }
                  },
                  ".card-title": {
                    "margin": "0"
                  }
                }
              }
            },
            ".card-link:hover .card-wrapper .card-overlay": {
              "opacity": ".7"
            },
            ".card-link:hover .card-wrap": {
              "transform": "translate(0, 0)"
            },
            ".card-link:hover .card-wrap span": {
              "opacity": "1",
              "color": "@overlayCard"
            },
            ".mbr-section-title": {
              "color": "#46414c"
            },
            ".card-title, .mbr-iconfont": {
              "color": "#000000"
            },
            ".card-link:hover .card-wrap .card-title": {
              "color": "@overlayCard"
            }
          },
          "_name": "features4",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Color\" name=\"border\" value=\"#e5e5e5\" condition=\"showTitle\" selected>\n        <select title=\"Cards\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\" selected>9</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Card Overlay\" name=\"overlayCard\" value=\"#124AD6\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\"><b>Ofrecemos productos estandarizados y especializados para la construcción.</b><div><b>Además de los que encuentra en nuestro portafolio desarrollamos soluciones especializadas de acuerdo a los requerimientos de cada proyecto.</b></div></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row justify-content-center cards\">\n            <div class=\"col-12 col-lg-4 col-md-6 card\">\n                <a class=\"card-link\" href=\"adoquines-losetas.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/adoquin-y-losetas-min-1-369x655.jpg\" alt=\"Adoquines y Losetas\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b><a href=\"adoquines-losetas.html\" class=\"text-primary\">Adoquines y Losetas pétreos</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 1\">\n                <a class=\"card-link\" href=\"agregados-petreos.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-petreos-02-768x524.jpg-750x512.jpg\" alt=\"Agregados pétreos\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b><a href=\"agregados-petreos.html\" class=\"text-primary\">Agregados pétreos</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 2\">\n                <a class=\"card-link\" href=\"bloques-de-concreto.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/bloques-1-640x480.jpg\" alt=\"Bloques de concreto\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b><a href=\"bloques-de-concreto.html\" class=\"text-primary\">Bloques de concreto</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 3\">\n                <a class=\"card-link\" href=\"box-culvert.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/boxculvert-750x422.jpg\" alt=\"Box Culvert\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b><a href=\"box-culvert.html\" class=\"text-primary\">Box Culvert</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 4\">\n                <a class=\"card-link\" href=\"espacios-publicos-y-cerramientos-bordillos-sardineles.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/espacios-publicos-cerramientos-bordillos-sardineles-450x429.png\" alt=\"Espacios públicos y cerramientos - Bordillos - Sardineles\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b><a href=\"espacios-publicos-y-cerramientos-bordillos-sardineles.html\" class=\"text-primary\">Espacios públicos y cerramientos - Bordillos - Sardineles</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 5\">\n                <a class=\"card-link\" href=\"postes-de-concreto.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/postes-5-700x933.jpg\" alt=\"Postes de concreto\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b><a href=\"postes-de-concreto.html\" class=\"text-primary\">Postes de concreto</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 6\">\n                <a class=\"card-link\" href=\"prefabricados-estructurales.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/prefabricados-estructurales-768x505.webp\" alt=\"Prefabricados Estructurales\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b><a href=\"prefabricados-estructurales.html\" class=\"text-primary\">Prefabricados Estructurales</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 7\">\n                <a class=\"card-link\" href=\"transporte.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/transporte-sardineles-750x563.jpg\" alt=\"Trasnporte\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b><a href=\"transporte.html\" class=\"text-primary\">Transporte</a></b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 8\">\n                <a class=\"card-link\" href=\"traviesas-y-fijaciones.html\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/traviesas-fijaciones.webp\" alt=\"Traviesas y Fijaciones\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b><a href=\"traviesas-y-fijaciones.html\" class=\"text-primary\">Traviesas y Fijaciones</a></b></h4>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tbW5suflSg",
