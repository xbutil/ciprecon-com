                "overflow": "visible",
                "padding": "0 12px 0 0",
                "justify-content": "flex-start",
                "margin-top": "0",
                "margin-left": "28px",
                "box-shadow": "none",
                "&:first-child": {
                  "margin-left": "9.6px"
                },
                "&:focus": {
                  "box-shadow": "none"
                },
                "span": {
                  "position": "absolute",
                  "right": "-12px",
                  "width": "18px",
                  "height": "18px",
                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@infoColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".text-wrapper": {
              "margin": "0 160px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "margin": "0 30px"
              },
              ".mbr-section-title": {
                "margin-bottom": "20px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "12px"
                }
              }
            },
