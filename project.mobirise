          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-btn": {
              ".btn": {
                "height": "21px",
                "min-width": "70px",
                "position": "relative",
                "overflow": "visible",
                "padding": "0 12px 0 0",
                "justify-content": "flex-start",
                "margin-top": "0",
                "margin-left": "28px",
                "box-shadow": "none",
                "&:first-child": {
                  "margin-left": "9.6px"
                },
                "&:focus": {
                  "box-shadow": "none"
                },
                "span": {
                  "position": "absolute",
                  "right": "-12px",
                  "width": "18px",
                  "height": "18px",
                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@primaryColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".title-container": {
              "display": "flex",
              "justify-content": "space-between",
              "margin": "0 160px 180px",
              "padding": "20px 40px 0 0",
              "border-top": "2px solid @border_1",
              "position": "relative",
              "@media (max-width: 992px)": {
                "display": "block",
                "margin": "0 30px 100px",
                "padding": "12px 0 0 0"
              },
              ".title-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".mbr-section-title": {
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                }
              }
            },
            ".cards": {
              "margin": "0 160px",
              "@media (max-width: 992px)": {
                "margin": "0 16px"
              },
              ".card": {
                "@media (max-width: 1040px)": {
                  "padding": "0 12px"
                },
                ".mbr-amount": {
                  "margin": "0",
                  "padding-bottom": "20px",
                  "border-bottom": "2px solid @border_2",
                  "@media (max-width: 992px)": {
                    "padding-bottom": "12px"
                  }
                },
                ".mbr-desc": {
                  "margin": "20px 0 0 0",
                  "@media (max-width: 992px)": {
                    "margin": "12px 0 0 0"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#46414c"
            },
            ".mbr-amount": {
              "color": "#3575bd"
            },
            ".mbr-desc": {
              "color": "#46414c"
            }
          },
          "_name": "features2",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Title Border\" name=\"border_1\" value=\"#e5e5e5\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"color\" title=\"BG Icon\" name=\"iconBg\" value=\"#124AD6\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color Icon\" name=\"iconColor\" value=\"#ffffff\" condition=\"showButtons\">\n        <select title=\"Cards\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <input type=\"color\" title=\"Card Border\" name=\"border_2\" value=\"#124AD6\" selected>\n        <input type=\"checkbox\" title=\"Amount\" name=\"showAmount\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-container\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"> Experiencia y calidad avalada por nuestros clientes<br></h2>\n                        <h4 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\"><br>Somos certificados en:<br><b>ISO 9001:2008 y OHSAS 18000:2007</b></h4>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-5\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"nosotros.html\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Nosotros</a></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row cards justify-content-center\">\n            <div class=\"col-12 col-lg-3 col-md-6 card\">\n                <p class=\"mbr-amount mbr-fonts-style\" data-app-selector=\".mbr-amount\" mbr-theme-style=\"display-1\" mbr-if=\"showAmount\"><b>30+</b></p>\n                <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\">\n                    Años de experiencia</p>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"cards > 1\">\n                <p class=\"mbr-amount mbr-fonts-style\" data-app-selector=\".mbr-amount\" mbr-theme-style=\"display-1\" mbr-if=\"showAmount\">\n                    <b>932+</b>\n                </p>\n                <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\">\n                    Clientes satisfechos</p>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"cards > 2\">\n                <p class=\"mbr-amount mbr-fonts-style\" data-app-selector=\".mbr-amount\" mbr-theme-style=\"display-1\" mbr-if=\"showAmount\"><b>40,000+</b></p>\n                <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\">\n                    Postes vendidos</p>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"cards > 3\">\n                <p class=\"mbr-amount mbr-fonts-style\" data-app-selector=\".mbr-amount\" mbr-theme-style=\"display-1\" mbr-if=\"showAmount\">\n                    <b>+2 </b><small><small>millones</small></small><b>&nbsp;</b></p>\n                <p class=\"mbr-desc mbr-fonts-style\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-5\" mbr-if=\"showDesc\">\n                    de traviesas vendidas</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_JSplaceholders": [],
          "_PHPplaceholders": [],
          "_anchor": "features2-z",
          "_isUserblock": true,
          "_cid": "uFR4ThNzx6",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
