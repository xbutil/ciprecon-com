              ".nav-link": {
                "display": "flex",
                "justify-content": "center",
                "align-items": "center",
                "width": "8px",
                "height": "8px",
                "margin": "6px",
                "padding": "0",
                "background": "transparent",
                "border": "1px solid @tabsBorder",
                "border-radius": "50%",
                "transition": "all .3s ease",
                "p": {
                  "margin": "0",
                  "display": "none",
                  "transition": "all .3s ease"
                }
              },
              ".nav-link.active": {
                "border": "2px solid @tabsBorder",
                "width": "50px",
                "height": "50px",
                "transition": "all .3s ease",
                "p": {
