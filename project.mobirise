            ".title-wrapper": {
              "margin-left": "160px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "margin": "0 30px"
              },
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "30px"
              }
            },
            ".text-wrapper": {
              "margin-right": "160px",
              "position": "relative",
              "margin-bottom": "120px",
              "@media (max-width: 992px)": {
                "margin": "0 30px 60px"
              },
              "& when (@reverseContent)": {
                "margin-right": "0",
                "margin-left": "160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px"
                }
              }
            },
            ".cards": {
              "margin": "0 144px",
              "@media (max-width: 992px)": {
                "margin": "0 18px"
              }
            },
            ".card:hover .mbr-section-btn .btn": {
              "transform": "scale(1) !important",
              "color": "@infoColor !important",
              "span": {
                "width": "28px",
                "border-radius": "22px",
                "right": "-28px"
              }
            },
            ".card": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              "@media (max-width: 768px)": {
                "margin-bottom": "30px"
              },
              "&:hover": {
                ".card-wrapper": {
                  "background-color": "@activeCard",
                  ".card-wrap_1": {
                    "border-color": "@activeBorder"
                  }
                }
              },
              ".card-wrapper": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "min-height": "320px",
                "padding": "40px",
                "background-color": "@card",
                "transition": "all .3s ease",
                "@media (max-width: 992px)": {
                  "padding": "25px",
                  "min-height": "320px"
                },
                "@media (max-width: 768px)": {
                  "min-height": "320px"
                },
                ".card-wrap_1": {
                  "border-top": "2px solid @border",
                  "padding-top": "10px",
                  "transition": "all .3s ease",
                  ".mbr-date": {
                    "margin-bottom": "20px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  },
                  ".mbr-card-title": {
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "40px"
                    },
                    "@media (max-width: 768px)": {
                      "margin-bottom": "30px"
                    }
                  }
                },
                ".card-wrap_2": {
                  ".mbr-card-text": {
                    "margin-bottom": "40px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#124ad6"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-date": {
