          "_name": "features4",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Color\" name=\"border\" value=\"#e5e5e5\" condition=\"showTitle\" selected>\n        <select title=\"Cards\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Card Overlay\" name=\"overlayCard\" value=\"#124AD6\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle || showDesc\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>NUESTROS MATERIALES</b></h2>\n                    <p class=\"mbr-desc mbr-fonts-style mt-4\" data-app-selector=\".mbr-desc\" mbr-theme-style=\"display-7\" mbr-if=\"showDesc\">Cada producto se ajusta a las especificaciones técnicas exigidas por los proyectos de infraestructura urbana, rural y vial, con disponibilidad para despachos a gran escala.<br><br>¡Conozca acá todos nuestros productos!<br><br></p>\n                </div>\n            </div>\n        </div>\n        <div class=\"row justify-content-center cards\">\n            <div class=\"col-12 col-lg-4 col-md-6 card\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-roca-triturada-864x1152.jpeg\" alt=\"Rocas\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Roca triturada</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 1\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-grava-626x352.jpg\" alt=\"Grava\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Gravas</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 2\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-arena-582x543.jpg\" alt=\"Arenas\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Arenas</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 3\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-sub-base-582x651.jpg\" alt=\"Bases y sub-bases\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b>Bases y sub-bases</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 4\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-balasto-626x417.jpg\" alt=\"Balasto\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b>Balasto y sub-balasto</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 5\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/agregados-planta-trituracion-875x493.jpg\" alt=\"Material de relleno y recebo\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b>Material de relleno y recebo</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 6\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/prefabricados-estructurales-768x505.webp\" alt=\"Prefabricados Estructurales\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\"><b>Prefabricados Estructurales</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 7\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/transporte-sardineles-750x563.jpg\" alt=\"Trasnporte\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Transporte</b></h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 8\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/traviesas-fijaciones.webp\" alt=\"Traviesas y Fijaciones\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Traviesas y Fijaciones</b></h4>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
