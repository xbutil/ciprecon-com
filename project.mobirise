          "_name": "content9",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content9\" group=\"List\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#e5e5e5\" selected>\n        <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"color\" title=\"Items Border\" name=\"borderItems\" value=\"#124AD6\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"content-wrapper\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"><b>Aplicaciones comunes</b></h3>\n                    <div class=\"list-wrapper\">\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-5\"><span class=\"mdi-navigation-check mbr-iconfont\"></span> Obras de drenaje pluvial y sanitario</p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-5\" mbr-if=\"items > 1\"><span class=\"mdi-navigation-check mbr-iconfont\"></span> Pasos subterráneos vehiculares o peatonales</p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-5\" mbr-if=\"items > 2\"><span class=\"mdi-navigation-check mbr-iconfont\"></span> Cruces hidráulicos en vías</p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-5\" mbr-if=\"items > 3\"><span class=\"mdi-navigation-check mbr-iconfont\"></span> Canalización de quebradas o ríos menores</p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-5\" mbr-if=\"items > 4\"><span class=\"mdi-navigation-check mbr-iconfont\"></span> Estructuras de contención o túneles técnicos</p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-1\" mbr-if=\"items > 5\">\n                            <b>Timber industry</b>\n                        </p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-1\" mbr-if=\"items > 6\">\n                            <b>Sponsorship</b>\n                        </p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-1\" mbr-if=\"items > 7\">\n                            <b>Mining industry</b>\n                        </p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-1\" mbr-if=\"items > 8\">\n                            <b>Warehouse</b>\n                        </p>\n                        <p class=\"mbr-item mbr-fonts-style\" data-app-selector=\".mbr-item\" mbr-theme-style=\"display-1\" mbr-if=\"items > 9\">\n                            <b>Water industry</b>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uM7e4evv3b",
          "_anchor": "contenido-aplicaciones-comunes",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-btn": {
              ".btn": {
                "height": "21px",
                "min-width": "70px",
                "position": "relative",
                "overflow": "visible",
                "padding": "0 12px 0 0",
                "justify-content": "flex-start",
                "margin-left": "28px",
                "box-shadow": "none",
                "&:first-child": {
                  "margin-left": "9.6px"
                },
                "&:focus": {
                  "box-shadow": "none"
                },
                "span": {
                  "position": "absolute",
                  "right": "-12px",
                  "width": "18px",
                  "height": "18px",
                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@infoColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".title-wrapper": {
              "margin-left": "160px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "margin": "0 30px"
              },
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "30px"
              }
            },
            ".text-wrapper": {
              "margin-right": "160px",
              "position": "relative",
              "margin-bottom": "120px",
              "@media (max-width: 992px)": {
                "margin": "0 30px 60px"
              },
              "& when (@reverseContent)": {
                "margin-right": "0",
                "margin-left": "160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px"
                }
              }
            },
            ".cards": {
              "margin": "0 144px",
              "@media (max-width: 992px)": {
                "margin": "0 18px"
              }
            },
            ".card:hover .mbr-section-btn .btn": {
              "transform": "scale(1) !important",
              "color": "@infoColor !important",
              "span": {
                "width": "28px",
                "border-radius": "22px",
                "right": "-28px"
              }
            },
            ".card": {
              "margin-bottom": "60px",
              "@media (max-width: 992px)": {
                "margin-bottom": "40px"
              },
              "@media (max-width: 768px)": {
                "margin-bottom": "30px"
              },
              "&:hover": {
                ".card-wrapper": {
                  "background-color": "@activeCard",
                  ".card-wrap_1": {
                    "border-color": "@activeBorder"
                  }
                }
              },
              ".card-wrapper": {
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "min-height": "320px",
                "padding": "40px",
                "background-color": "@card",
                "transition": "all .3s ease",
                "@media (max-width: 992px)": {
                  "padding": "25px",
                  "min-height": "320px"
                },
                "@media (max-width: 768px)": {
                  "min-height": "320px"
                },
                ".card-wrap_1": {
                  "border-top": "2px solid @border",
                  "padding-top": "10px",
                  "transition": "all .3s ease",
                  ".mbr-date": {
                    "margin-bottom": "20px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "12px"
                    }
                  },
                  ".mbr-card-title": {
                    "margin-bottom": "60px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "40px"
                    },
                    "@media (max-width: 768px)": {
                      "margin-bottom": "30px"
                    }
                  }
                },
                ".card-wrap_2": {
                  ".mbr-card-text": {
                    "margin-bottom": "40px",
                    "@media (max-width: 992px)": {
                      "margin-bottom": "20px"
                    }
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#124ad6"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-date": {
              "color": "#ffffff"
            },
            ".mbr-card-title": {
              "color": "#FFFFFF"
            },
            ".mbr-card-text": {
              "color": "#FFFFFF"
            }
          },
          "_name": "features6",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features6\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <select title=\"Amount\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Card\" name=\"card\" value=\"#051744\" selected>\n        <input type=\"color\" title=\"Card Active\" name=\"activeCard\" value=\"#124AD6\" selected>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#124AD6\" selected>\n        <input type=\"color\" title=\"Active Border\" name=\"activeBorder\" value=\"#000000\" selected>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Date\" name=\"showCardDate\">\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"BG Icon\" name=\"iconBg\" value=\"#ffffff\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color Icon\" name=\"iconColor\" value=\"#124AD6\" condition=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background3-1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                        <b>In the news</b>\n                    </h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"text-wrapper\">\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto corporis dicta dolore eaque\n                        ex illo iure, labore quas rem soluta? Ab beatae est fugit in itaque nisi, nobis omnis voluptate.\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"row cards\">\n            <div class=\"col-12 col-lg-6 card\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">\n                            Tecnología</p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Uniones o Juntas</b></h4>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/box-culvert-1-752x564.jpg\" alt=\"Box Culvert\">\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">Nuestros Box Culvert se fabrican con un sistema de campana espigo, lo cual garantiza un acople perfecto entre las secciones, reduciendo la migración de finos del suelo y agua entre las secciones de caja y área circundante.<br>Se instalan con Sika Lockstop, lo cual crea un sello hermético entre la estructura de concreto. Sika Lockstop no se expande o crea presión interna en la junta, requiere un recubrimiento mínimo de concreto ofrece facilidad y rapidez de la aplicación, con la correspondiente disminución de la mano de obra. Su aplicación es limpia, no hay desperdicios, no hay necesidad de limpiar las herramientas o las manos y no hay malos olores durante la aplicación, no se escurre en superficies verticales y se adapta fácilmente a las diferentes formas de la superficie donde va a ser aplicado.<br></p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-info-outline\" href=\"plantas-de-produccion.html\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Plantas</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"cards > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">Material de calidad</p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Dimensiones</b></h4>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/box-culvert-2-752x564.jpg\" alt=\"Box Culvert\">\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">Las secciones de Box Culvert prefabricadas se diseñan cumpliendo con las especificaciones y requerimientos de cada proyecto, de acuerdo con  las cargas, suelos y necesidades de la obra. Gracias a la producción en planta la geometría detallada en el plano se garantiza, ya que se fabrican mediante un proceso estandarizado.<br><br><b>Normas aplicables:</b><br><br><b>• NTC 5558 – </b>Bandas sellantes para juntas de tuberías y Box Culvert.<br><br><b>• NTC 5672 – </b>Secciones rectangulares prefabricadas de concreto reforzado <b>“Box Culvert”</b> para alcantarillados de aguas lluvias y aguas servidas.<br><br></p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-info-outline\" href=\"nuetros-clientes.html\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Clientes</a></div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"cards > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">\n                            March 14, 2023\n                        </p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Global every time</b>\n                        </h4>\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">\n                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Distinctio doloribus eaque\n                            eligendi, hic incidunt iste itaque quae repellendus repudiandae rerum saepe vel veritatis.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Company\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"cards > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">\n                            Jan 24, 2021\n                        </p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Our products was first</b></h4>\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">\n                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Distinctio doloribus eaque\n                            eligendi, hic incidunt iste itaque quae repellendus repudiandae rerum saepe vel veritatis.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Company\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"cards > 4\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date, .mbr-section-btn\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">\n                            Jan 03, 2023\n                        </p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Description company</b></h4>\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">\n                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Distinctio doloribus eaque\n                            eligendi, hic incidunt iste itaque quae repellendus repudiandae rerum saepe vel veritatis.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Company\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6 card\" mbr-if=\"cards > 5\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-wrap_1\">\n                        <p class=\"mbr-date mbr-fonts-style\" data-app-selector=\".mbr-date\" mbr-theme-style=\"display-4\" mbr-if=\"showCardDate\">\n                            March 14, 2023\n                        </p>\n                        <h4 class=\"mbr-card-title mbr-fonts-style\" data-app-selector=\".mbr-card-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showCardTitle\">\n                            <b>Global every time</b></h4>\n                    </div>\n                    <div class=\"card-wrap_2\">\n                        <p class=\"mbr-card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\" data-app-selector=\".mbr-card-text\">\n                            Lorem ipsum dolor sit amet, consectetur adipisicing elit. Distinctio doloribus eaque\n                            eligendi, hic incidunt iste itaque quae repellendus repudiandae rerum saepe vel veritatis.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Company\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
