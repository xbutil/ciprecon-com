        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row": {
              "@media (max-width: 992px)": {
                "flex-direction": "column-reverse"
              }
            },
            ".mbr-section-btn-2": {
              "text-align": "left"
            },
            ".mbr-section-btn": {
              ".btn": {
                "height": "21px",
                "min-width": "70px",
                "position": "relative",
                "overflow": "visible",
                "padding": "0 12px 0 0",
                "justify-content": "flex-start",
                "margin-left": "28px",
                "box-shadow": "none",
                "&:first-child": {
                  "margin-left": "9.6px"
                },
                "&:focus": {
                  "box-shadow": "none"
                },
                "span": {
                  "position": "absolute",
                  "right": "-12px",
                  "width": "18px",
                  "height": "18px",
                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@primaryColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".list-wrapper": {
              "margin-left": "160px",
              "border-top": "2px solid @border",
              "padding-top": "20px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "margin": "0 30px",
                "padding-top": "12px"
              },
              "& when (@reverseContent)": {
                "margin-left": "0",
                "margin-right": "160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px 20px"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "40px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              },
              ".mbr-list": {
                "margin-bottom": "30px",
                "padding": "0",
                "list-style-type": "none",
                "li": {
                  "padding-bottom": "6px",
                  "margin-bottom": "20px",
                  "position": "relative",
                  "&:hover": {
                    "&::before": {
                      "width": "0"
                    }
                  },
                  "&::before": {
                    "content": "''",
                    "position": "absolute",
                    "left": "0",
                    "bottom": "0",
                    "display": "block",
                    "width": "100%",
                    "height": "2px",
                    "background-color": "@borderList",
                    "transition": "all .3s ease"
                  },
                  "@media (max-width: 992px)": {
                    "width": "fit-content"
                  }
                }
              }
            },
            ".text-wrapper": {
              "margin": "0 160px 0 100px",
              "border-top": "2px solid @border",
              "padding-top": "20px",
              "position": "relative",
              "@media (max-width: 992px)": {
                "margin": "0 30px 20px",
                "padding-top": "12px"
              },
              "& when (@reverseContent)": {
                "margin": "0 100px 0 160px",
                "@media (max-width: 992px)": {
                  "margin": "0 30px 20px"
                }
              },
              ".mbr-section-title": {
                "margin-bottom": "40px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "20px"
                }
              },
              ".mbr-text": {
                "margin": "0"
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            },
            ".mbr-list": {
              "color": "#124ad6"
            }
          },
          "_name": "content7",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"content7\" group=\"Content\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title 1\" name=\"showTitle_1\" checked>\n        <input type=\"checkbox\" title=\"Title 2\" name=\"showTitle_2\" checked>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#e5e5e5\" selected>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Border List\" name=\"borderList\" value=\"#124AD6\" condition=\"showList\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons_2\" checked>\n        <input type=\"color\" title=\"BG Icon\" name=\"iconBg\" value=\"#124AD6\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color Icon\" name=\"iconColor\" value=\"#ffffff\" condition=\"showButtons\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background3.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\" mbr-class=\"{'flex-row-reverse' : reverseContent}\">\n            <div class=\"col-12 col-lg-4\">\n                <div class=\"list-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle_1\">\n                        Nuestra propuesta de valor combina:</h2>\n                    <ul class=\"mbr-list mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-list\" data-multiline mbr-article mbr-if=\"showList\">\n                        <li>Calidad técnica certificada</li>\n                        <li>Compromiso ambiental</li>\n                        <li>Procesos innovadores</li>\n                        <li>Logística eficiente</li><li>Atención personalizada</li>\n                    </ul>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                        <a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>See more\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-8\">\n                <div class=\"text-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle_2\"><b>¡Conozca todos nuestros productos y cotice con nosotros!</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Nuestra asesoría comercial y técnica está lista para acompañarlo.<br><br></p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn-2\" mbr-if=\"showButtons_2\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-primary\" href=\"contactenos.html\" data-app-placeholder=\"Type Text\">Solicite su cotización ahora</a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
