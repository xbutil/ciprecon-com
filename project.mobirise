          "_name": "tabs1",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"tabs1\" group=\"List\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\" plugins=\"mbr-tabs\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <select title=\"Count\" name=\"bootstrapTabs\">\n            <option value=\"1\" selected>1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n        </select>\n        <input type=\"color\" title=\"Container\" name=\"container\" value=\"#3575bd\">\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"BG Icon\" name=\"iconBg\" value=\"#ffffff\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color Icon\" name=\"iconColor\" value=\"#124AD6\" condition=\"showButtons\">\n        <input type=\"checkbox\" title=\"Amount\" name=\"showAmount\" checked>\n        <input type=\"checkbox\" title=\"Description\" name=\"showDescription\" checked>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#ffffff\" condition=\"showDescription\">\n        <input type=\"color\" title=\"Tabs Border\" name=\"tabsBorder\" value=\"#000000\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12 col-lg-12\">\n                <div class=\"tab-content\">\n                    <div id=\"tab1\" class=\"tab-pane in active\" role=\"tabpanel\">\n                        <div class=\"row\">\n                            <div class=\"col-lg-12\">\n                                <div class=\"card\">\n                                    <img src=\"@PROJECT_PATH@/assets/images/planta-prefabricados-aerea-min-1.webp\" alt=\"Planta de prefabricados Ciénaga Magdalena Colombia\">\n                                    <div class=\"card-container\">\n                                        <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                            We have worked in various parts of the world\n                                        </h4>\n                                        <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                            <b>1- PLANTA DE PREFABRICADOS</b></h3>\n                                        <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\"><b>\n                                            Dirección</b><br>600 metros al sur de la Estación del Ferrocarril<br>Ciénaga – Magdalena<br>Colombia – Sur América</p>\n                                        <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                            <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                            </a>\n                                        </div>\n                                        <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\"><a href=\"tel:+57-313 397-4154\" class=\"text-white\">(+57) 313 397-4154</a><br></p>\n                                        <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                            <b><br></b><br><b>Horario de atención:</b><br><br>Lunes a viernes: 8 AM - 5 PM<br>Sábados: 9 AM - 12 PM</p>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab2\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 1\">\n                        <div class=\"row\">\n                            <div class=\"card\">\n                                <img src=\"@THEME_PATH@/components/_images/global/image16.jpg\" alt=\"Mobirise\">\n                                <div class=\"card-container\">\n                                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                        <b>Meet our global partnerships</b>\n                                    </h4>\n                                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                        <b>Enduring partnerships</b>\n                                    </h3>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto beatae\n                                        error facere itaque, minima officiis quia repudiandae saepe suscipit. Atque\n                                        facere illum odio porro quibusdam quod rerum sapiente vero voluptate. Lorem\n                                        ipsum dolor sit amet, consectetur adipisicing elit. Ab alias aliquam amet\n                                        commodi dolorem earum eos.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                        </a>\n                                    </div>\n                                    <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\">\n                                        <b>50+</b>\n                                    </p>\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                        <b>Amount more</b>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab3\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 2\">\n                        <div class=\"row\">\n                            <div class=\"card\">\n                                <img src=\"@THEME_PATH@/components/_images/global/image13.jpg\" alt=\"Mobirise\">\n                                <div class=\"card-container\">\n                                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                        <b>Your company isn’t like any other</b>\n                                    </h4>\n                                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                        <b>Industry global specialization</b>\n                                    </h3>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto beatae\n                                        error facere itaque, minima officiis quia repudiandae saepe suscipit. Atque\n                                        facere illum odio porro quibusdam quod rerum sapiente vero voluptate. Lorem\n                                        ipsum dolor sit amet, consectetur adipisicing elit. Ab alias aliquam amet\n                                        commodi dolorem earum eos.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                        </a>\n                                    </div>\n                                    <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\">\n                                        <b>100%</b>\n                                    </p>\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                        <b>Percent</b>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab4\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 3\">\n                        <div class=\"row\">\n                            <div class=\"card\">\n                                <img src=\"@THEME_PATH@/components/_images/global/image7.jpg\" alt=\"Mobirise\">\n                                <div class=\"card-container\">\n                                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                        <b>Ab alias aliquam amet commodi dolorem earum eos</b>\n                                    </h4>\n                                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                        <b>Global contract certainty</b>\n                                    </h3>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto beatae\n                                        error facere itaque, minima officiis quia repudiandae saepe suscipit. Atque\n                                        facere illum odio porro quibusdam quod rerum sapiente vero voluptate. Lorem\n                                        ipsum dolor sit amet, consectetur adipisicing elit. Ab alias aliquam amet\n                                        commodi dolorem earum eos.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                        </a>\n                                    </div>\n                                    <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\">\n                                        <b>10%</b>\n                                    </p>\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                        <b>Percent</b>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab5\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 4\">\n                        <div class=\"row\">\n                            <div class=\"card\">\n                                <img src=\"@THEME_PATH@/components/_images/global/image10.jpg\" alt=\"Mobirise\">\n                                <div class=\"card-container\">\n                                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                        <b>Atque facere illum odio porro quibusdam quod</b>\n                                    </h4>\n                                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                        <b>Global - your choice, your advantage</b>\n                                    </h3>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto beatae\n                                        error facere itaque, minima officiis quia repudiandae saepe suscipit. Atque\n                                        facere illum odio porro quibusdam quod rerum sapiente vero voluptate. Lorem\n                                        ipsum dolor sit amet, consectetur adipisicing elit. Ab alias aliquam amet\n                                        commodi dolorem earum eos.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                        </a>\n                                    </div>\n                                    <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\">\n                                        <b>1000+</b>\n                                    </p>\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                        <b>Global more</b>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div id=\"tab6\" class=\"tab-pane\" role=\"tabpanel\" mbr-if=\"bootstrapTabs > 5\">\n                        <div class=\"row\">\n                            <div class=\"card\">\n                                <img src=\"@THEME_PATH@/components/_images/global/image9.jpg\" alt=\"Mobirise\">\n                                <div class=\"card-container\">\n                                    <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-section-subtitle\" mbr-if=\"showSubtitle\">\n                                        <b>Ipsum dolor sit amet, consectetur adipisicing elit.</b>\n                                    </h4>\n                                    <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".mbr-section-title, .mbr-section-btn\" mbr-if=\"showTitle\">\n                                        <b>Industry global specialization</b>\n                                    </h3>\n                                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text\" mbr-if=\"showText\">\n                                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Architecto beatae\n                                        error facere itaque, minima officiis quia repudiandae saepe suscipit. Atque\n                                        facere illum odio porro quibusdam quod rerum sapiente vero voluptate. Lorem\n                                        ipsum dolor sit amet, consectetur adipisicing elit. Ab alias aliquam amet\n                                        commodi dolorem earum eos.\n                                    </p>\n                                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\">\n                                        <a class=\"btn btn-info-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                                <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont\n                                                 mbr-iconfont-btn\"></span>Company\n                                        </a>\n                                    </div>\n                                    <p class=\"mbr-amount mbr-fonts-style\" mbr-theme-style=\"display-1\" data-app-selector=\".mbr-amount\" mbr-if=\"showAmount\">\n                                        <b>99+</b>\n                                    </p>\n                                    <p class=\"mbr-desc mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-desc\" mbr-if=\"showDescription\">\n                                        <b>Specialisation</b>\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12\">\n                <ul class=\"nav nav-tabs\" role=\"tablist\">\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item first mbr-fonts-style\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style show active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs1-d_tab0\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            <p>01</p>\n                        </a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 1\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs1-d_tab1\" data-app-placeholder=\"Type Text\" aria-selected=\"false\">\n                            <p>02</p>\n                        </a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 2\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs1-d_tab2\" data-app-placeholder=\"Введите Текст\" aria-selected=\"true\">\n                            <p>03</p>\n                        </a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 3\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\"><a class=\"nav-link mbr-fonts-style active\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tabs1-d_tab3\" data-app-placeholder=\"Введите Текст\" aria-selected=\"true\">\n                            <p>04</p>\n                        </a></li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 4\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                        <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab5\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            <p>05</p>\n                        </a>\n                    </li>\n                    <li mbr-buttons mbr-theme-style=\"display-7\" class=\"nav-item\" mbr-if=\"bootstrapTabs > 5\" data-toolbar=\"-mbrBtnAdd,-mbrBtnMove,-mbrLink,-mbrBtnRemove,-iconFont\">\n                        <a class=\"nav-link mbr-fonts-style\" role=\"tab\" data-toggle=\"tab\" data-bs-toggle=\"tab\" href=\"#tab6\" data-app-placeholder=\"Type Text\" aria-selected=\"true\">\n                            <p>06</p>\n                        </a>\n                    </li>\n                </ul>\n      