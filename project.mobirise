        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-btn": {
              ".btn": {
                "height": "21px",
                "min-width": "70px",
                "position": "relative",
                "overflow": "visible",
                "padding": "0 12px 0 0",
                "justify-content": "flex-start",
                "margin-top": "0",
                "margin-left": "28px",
                "box-shadow": "none",
                "&:first-child": {
                  "margin-left": "9.6px"
                },
                "&:focus": {
                  "box-shadow": "none"
                },
                "span": {
                  "position": "absolute",
                  "right": "-12px",
                  "width": "18px",
                  "height": "18px",
                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@primaryColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".title-container": {
              "display": "flex",
              "justify-content": "space-between",
              "margin": "0 160px 110px",
              "padding": "20px 40px 0 0",
              "border-top": "2px solid @border",
              "position": "relative",
              "@media (max-width: 992px)": {
                "display": "block",
                "margin": "0 30px 60px",
                "padding": "12px 0 0 0"
              },
              ".title-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".mbr-section-title": {
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "20px"
                  }
                }
              }
            },
            ".cards": {
              "margin": "0 160px",
              "@media (max-width: 992px)": {
                "margin": "0 30px"
              },
              ".card": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "60px"
                },
                "@media (max-width: 768px)": {
                  "margin-bottom": "40px"
                },
                ".mbr-iconfont": {
                  "width": "100%",
                  "height": "70px",
                  "font-size": "70px",
                  "color": "@icon",
                  "margin-bottom": "40px",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "25px"
                  },
                  "@media (max-width: 768px)": {
                    "margin-bottom": "20px"
                  }
                },
                ".card-title": {
                  "margin-bottom": "0"
                },
                ".mbr-text": {
                  "margin": "20px 0 0 0",
                  "@media (max-width: 992px)": {
                    "margin-bottom": "12px"
                  }
                }
              }
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".card-title": {
              "color": "#000000"
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_name": "features3",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#e5e5e5\" selected>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"color\" title=\"BG Icon\" name=\"iconBg\" value=\"#124AD6\" condition=\"showButtons\">\n        <input type=\"color\" title=\"Color Icon\" name=\"iconColor\" value=\"#ffffff\" condition=\"showButtons\">\n        <select title=\"Cards\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Color\" name=\"icon\" value=\"#124AD6\" selected condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Text\" name=\"showCardText\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\">\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/planta-postes-768x576.jpeg-768x576.jpg\" parallax selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row align-items-center\">\n            <div class=\"col-12\">\n                <div class=\"title-container\">\n                    <div class=\"title-wrapper\">\n                        <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\"> <b>Intranet</b></h2>\n                    </div>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-primary-outline\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <span class=\"mobi-mbri mobi-mbri-arrow-next mbr-iconfont mbr-iconfont-btn\"></span>Start\n                        </a></div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row cards justify-content-center\">\n            <div class=\"col-12 col-lg-4 col-md-6 card\">\n                <a href=\"https://login.microsoft.com/\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-letter\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\">\n                    <b><a href=\"https://login.microsoft.com/\" class=\"text-primary\" target=\"_blank\">Correo corporativo</a></b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 1\">\n                <a href=\"https://bogota.ciprecon.com/pdffiles/\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-file\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\">\n                    <b><a href=\"https://192.168.5.1/pdffiles/\" class=\"text-primary\" target=\"_blank\">Reportes / PDFs</a></b><br><b><a href=\"https://192.168.5.1/pdffiles/\" class=\"text-primary\" target=\"_blank\">Oficina Bogotá</a></b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 2\">\n                <a href=\"https://docs.google.com/forms/d/1XiPCvnBGjzeYvrghxLlUq-1GsvqeLR7favSTPJZ5F4Y/edit?usp=sharing\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-cust-feedback\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\">\n                    <b><a href=\"https://docs.google.com/forms/d/1XiPCvnBGjzeYvrghxLlUq-1GsvqeLR7favSTPJZ5F4Y/edit?usp=sharing\" class=\"text-primary\" target=\"_blank\">Encuesta de satisfacción</a></b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 3\">\n                <a href=\"https://correoegroupware.ciprecon.com/\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-letter\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\">\n                    <b><a href=\"https://correoegroupware.ciprecon.com/\" class=\"text-primary\" target=\"_blank\">Correo eGroupware</a></b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 4\">\n                <a href=\"https://bogota.ciprecon.com/pdffiles/\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-file\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\"><b><a href=\"https://bogota.ciprecon.com/pdffiles/\" class=\"text-primary\" target=\"_blank\">Reportes / PDFs</a></b><div><b><a href=\"https://bogota.ciprecon.com/pdffiles/\" class=\"text-primary\" target=\"_blank\">Oficinas Externas</a></b></div></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 5\">\n                <a href=\"https://docs.google.com/forms/d/1gW8asbvPoroHvd1evr_GR_Z3OLWwbsXWnqlw49MbzPI/prefill\" target=\"_blank\"><span mbr-icon class=\"mbr-iconfont mbrib-edit\" mbr-if=\"showIcon\"></span></a>\n                <h5 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-7\" mbr-if=\"showCardTitle\">\n                    <b><a href=\"https://docs.google.com/forms/d/1gW8asbvPoroHvd1evr_GR_Z3OLWwbsXWnqlw49MbzPI/prefill\" class=\"text-primary\" target=\"_blank\">Formato PQRs</a></b></h5>\n                <p class=\"mbr-text mbr-fonts-style\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\" mbr-if=\"showCardText\">\n                    Lorem ipsum dolor sit amet, consectetur adipisicing elit. Adipisci doloribus eligendi id\n                    impedit\n                    maxime necessitatibus nulla praesentium quasi.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
