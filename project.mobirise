                  "font-size": "8px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "center",
                  "border-radius": "50%",
                  "background": "@iconBg",
                  "color": "@iconColor",
                  "margin": "2px 0 0 12px",
                  "padding-left": "2px",
                  "transition": "all .33s ease"
                },
                "&:hover": {
                  "transform": "scale(1) !important",
                  "color": "@primaryColor !important",
                  "span": {
                    "width": "28px",
                    "border-radius": "22px",
                    "right": "-28px"
                  }
                }
              }
            },
            ".title-container": {
              "display": "flex",
              "justify-content": "space-between",
              "margin": "0 160px 110px",
              "padding": "20px 40px 0 0",
              "border-top": "2px solid @border",
              "position": "relative",
              "@media (max-width: 992px)": {
                "display": "block",
                "margin": "0 30px 60px",
                "padding": "12px 0 0 0"
              },
              ".title-wrapper": {
                "width": "50%",
                "@media (max-width: 992px)": {
                  "width": "100%"
                },
                ".mbr-section-title": {
                  "margin-bottom": "0",
                  "@media (max-width: 992px)": {
