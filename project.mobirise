          "_customHTML": "<!-- Type valid HTML here -->\n\n<div>\n<iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3917.9805141386105!2d-74.80610492415781!3d10.889085189266634!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8ef5d320a38c4bd1%3A0x48200ff52fe9058f!2sPostes%20Ciprecon!5e0!3m2!1ses-419!2sco!4v1742360968197!5m2!1ses-419!2sco\" width=\"600\" height=\"450\" style=\"border:0;\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\"></iframe>\n</div>",
          "_customCSS": "/* Type valid CSS here */\n\ndiv {\n  padding: 0 0 80px;\n  color: #777;\n  text-align: center;\n}\np {\n  font-size: 60px;\n  color: #777;\n}",
          "alias": "code-editor",
          "_tags": [
            "Extension"
