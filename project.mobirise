          "_name": "clients1",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"clients1\" group=\"Clients\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"color\" title=\"Border\" name=\"border\" value=\"#e5e5e5\" selected>\n        <input type=\"range\" inline title=\"Items\" name=\"items\" min=\"1\" max=\"16\" value=\"15\" step=\"1\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"text-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>\n                        ¡Gracias por confiar en nosotros!</b></h2>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">Durante más de 30 años, empresas líderes en la industria colombiana han confiado en la calidad de nuestros productos y prefabricados.<br>Nos enorgullece suministrarles soluciones de primera categoría, en Ciprecon tenemos una solución para cada una de sus necesidades de construcción.\n                    </p>\n                </div>\n            </div>\n        </div>\n        <div class=\"row client-wrapper\">\n            <div class=\"col-12 col-lg-3 col-md-6 card\">\n                <img src=\"@PROJECT_PATH@/assets/images/ultracem-341x175.jpg\" alt=\"Ultracem\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 1\">\n                <img src=\"@PROJECT_PATH@/assets/images/bolivar-205x169.jpg\" alt=\"Constructora Bolívar\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 2\">\n                <img src=\"@PROJECT_PATH@/assets/images/drummond-205x169.jpg\" alt=\"Drummond Ltd. Colombia\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 3\">\n                <img src=\"@PROJECT_PATH@/assets/images/cemex-244x110.jpg\" alt=\"Cemex\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 4\">\n                <img src=\"@PROJECT_PATH@/assets/images/coninsa-ramon-h-316x159.png\" alt=\"Coninsa Ramon H\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 5\">\n                <img src=\"@PROJECT_PATH@/assets/images/constru-mole-220x110.jpg\" alt=\"Constru MOLE\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 6\">\n                <img src=\"@PROJECT_PATH@/assets/images/meco-173x107.jpg\" alt=\"MECO\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 7\">\n                <img src=\"@PROJECT_PATH@/assets/images/argos-220x110.jpg\" alt=\"Argos\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 8\">\n                <img src=\"@PROJECT_PATH@/assets/images/fenoco-220x110.jpg\" alt=\"Fenoco - Ferrocarriles del Norte de Colombia S.A.\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 9\">\n                <img src=\"@PROJECT_PATH@/assets/images/ani-220x110.jpg\" alt=\"ANI - Agencia Nacional de Infraestructura\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 10\">\n                <img src=\"@PROJECT_PATH@/assets/images/metro-de-medellin-220x110.jpg\" alt=\"Metro de Medellín\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 11\">\n                <img src=\"@PROJECT_PATH@/assets/images/concremovil-341x175.jpg\" alt=\"Concremóvil\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 12\">\n                <img src=\"@PROJECT_PATH@/assets/images/metro-block-220x110.jpg\" alt=\"MetroBlock\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 13\">\n                <img src=\"@PROJECT_PATH@/assets/images/constructora-vives-220x110.jpg\" alt=\"Constructora Vives\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 14\">\n                <img src=\"@PROJECT_PATH@/assets/images/electricaribe-354x169.jpg\" alt=\"Electricaribe\">\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-6 card\" mbr-if=\"items > 15\">\n                <img src=\"@THEME_PATH@/components/_images/3.png\" alt=\"Mobirise\">\n            </div>\n        </div>\n    </div>\n</section>",
          "_PHPplaceholders": [],
