              }
            },
            ".content-wrapper": {
              "display": "flex",
              "align-items": "center",
              "background-color": "@card",
              "border-radius": ".75rem",
              "padding": "48px",
              "height": "100%",
              "@media (max-width: 992px)": {
                "padding": "24px"
              },
              ".content-wrap": {
                "width": "100%",
                ".mbr-section-title": {
                  "margin-bottom": "32px"
                },
                ".mbr-text": {
                  "margin-bottom": "16px"
                },
                ".mbr-section-btn": {
                  ".btn": {
                    "&::before": {
                      "background-image": "linear-gradient(90deg, @active_2 0%, transparent 100%)"
