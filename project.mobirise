                      }
                    },
                    ".mbr-amount": {
                      "margin": "50px 0 20px",
                      "@media (max-width: 992px)": {
                        "margin": "30px 0 12px"
                      }
                    },
                    ".mbr-desc": {
                      "padding-top": "20px",
