                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "padding-top": "12px",
                  "margin-bottom": "60px"
                },
                "@media (max-width: 768px)": {
                  "margin-bottom": "40px"
                }
              }
            },
            ".cards": {
              "margin": "0 144px",
              "@media (max-width: 992px)": {
                "margin": "0 18px"
              },
              "@media (max-width: 768px)": {
                "margin": "0 30px"
              },
              ".card": {
                "margin-bottom": "80px",
                "@media (max-width: 992px)": {
                  "margin-bottom": "60px"
                },
                "@media (max-width: 767px)": {
                  "padding": "0"
                },
                ".card-wrapper": {
                  "position": "relative",
                  "width": "100%",
                  "min-height": "510px",
                  ".card-overlay": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "510px",
                    "background": "@overlayCard",
                    "opacity": "0",
                    "transition": "all .3s ease",
                    "z-index": "1",
                    "pointer-events": "none",
                    "@media (max-width: 992px)": {
                      "z-index": "0"
                    }
                  },
                  "img": {
                    "position": "absolute",
                    "top": "0",
                    "left": "0",
                    "width": "100%",
                    "height": "510px",
                    "object-fit": "cover",
                    "pointer-events": "visible"
                  }
                },
                ".card-wrap": {
                  "margin-top": "40px",
                  "display": "flex",
                  "transform": "translate(-36px, 0)",
                  "transition": "all .3s ease",
                  "@media (max-width: 992px)": {
                    "margin-top": "25px",
                    "transform": "none"
                  },
                  "span": {
                    "display": "flex",
                    "align-items": "center",
                    "font-size": "22px",
                    "margin-right": "12px",
                    "opacity": "0",
                    "transition": "all .4s ease",
                    "@media (max-width: 992px)": {
                      "opacity": "1"
                    }
                  },
                  ".card-title": {
                    "margin": "0 0 30px 0"
                  }
                }
              }
            },
            ".card-link:hover .card-wrapper .card-overlay": {
              "opacity": ".7"
            },
            ".card-link:hover .card-wrap": {
              "transform": "translate(0, 0)"
            },
            ".card-link:hover .card-wrap span": {
              "opacity": "1",
              "color": "@overlayCard"
            },
            ".mbr-section-title": {
              "color": "#000000"
            },
            ".card-title, .mbr-iconfont": {
              "color": "#000000"
            },
            ".card-link:hover .card-wrap .card-title": {
              "color": "@overlayCard"
            }
          },
          "_name": "features4",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features4\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen,\n                    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"color\" title=\"Color\" name=\"border\" value=\"#e5e5e5\" condition=\"showTitle\" selected>\n        <select title=\"Cards\" name=\"cards\">\n            <option value=\"1\">1</option>\n            <option value=\"2\" selected>2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n            <option value=\"9\">9</option>\n        </select>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"color\" title=\"Card Overlay\" name=\"overlayCard\" value=\"#124AD6\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#f4f4f6\" selected>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\" parallax>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n    <div mbr-class=\"{'container': !fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showTitle\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                        <b>Servicio de transporte</b></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row justify-content-center cards\">\n            <div class=\"col-12 col-lg-4 col-md-6 card\">\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>¡Calidad y experiencia!</b></h4>\n                    </div>                \n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/transporte.webp\" alt=\"Transporte\">\n                    </div>\n\n                \n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 1\">\n                \n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Cumplimiento y seguridad</b></h4>\n                    </div>\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"@PROJECT_PATH@/assets/images/transporte-sardineles.webp\" alt=\"Transporte\">\n                    </div>\n\n                \n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 2\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image14.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Project Management</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 3\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image2.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Description</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 4\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image4.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Maintenance</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 5\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image6.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Projects</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 6\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image17.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Description</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 7\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/global/image19.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Description</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n            <div class=\"col-12 col-lg-4 col-md-6 card\" mbr-if=\"cards > 8\">\n                <a class=\"card-link\" href=\"#\">\n                    <div class=\"card-wrapper\">\n                        <div class=\"card-overlay\"></div>\n                        <img src=\"../_images/background1.jpg\" alt=\"Mobirise\">\n                    </div>\n                    <div class=\"card-wrap\" mbr-if=\"showCardTitle\">\n                        <span mbr-icon class=\"mbr-iconfont mobi-mbri-right mobi-mbri\"></span>\n                        <h4 class=\"card-title mbr-fonts-style\" data-app-selector=\".card-title, .mbr-iconfont\" mbr-theme-style=\"display-5\">\n                            <b>Description</b>\n                        </h4>\n                    </div>\n                </a>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uMaG5WBCHo",
          "_anchor": "features4-91",
          "_PHPplaceholders": [],
          "_JSplaceholders": [],
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".row-main": {
              "margin-bottom": "200px",
              "@media (max-width: 992px)": {
                "margin-bottom": "140px"
              },
              "@media (max-width: 768px)": {
                "margin-bottom": "60px"
              }
            },
            ".title": {
              "@media (max-width: 992px)": {
                "display": "none"
              }
            },
            ".title-wrapper": {
              "img": {
                "width": "250px",
                "height": "75px",
                "object-fit": "cover",
                "margin-right": "12px",
                "border-radius": "0%"
              },
              ".mbr-section-title": {
                "margin": "0"
              }
            },
            ".list": {
              "list-style": "none",
              "padding-left": "0",
              "@media (max-width: 991px)": {
                "margin-bottom": "2rem"
              },
              "@media (min-width: 992px)": {
                "margin-bottom": "0"
              },
              "color": "#ddebfd"
            },
            ".social-wrapper": {
              "width": "100%"
            },
            ".social-row": {
              "display": "inline-flex",
              "flex-wrap": "wrap",
              "margin-top": "20px",
              "@media (max-width: 992px)": {
                "margin-top": "12px"
              }
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "margin-right": "18px",
              "margin-bottom": "20px",
              "height": "18px",
              "width": "18px",
              "a span": {
                "font-size": "18px"
              }
            },
            ".card-list": {
              "@media (max-width: 768px)": {
                "display": "none"
              }
            },
            ".mbr-section-subtitle": {
              "margin-bottom": "20px",
              "@media (max-width: 992px)": {
                "margin-bottom": "12px"
              },
              "@media (max-width: 768px)": {
                "display": "none"
              },
              "color": "#8c8c8c"
            },
            ".mbr-text": {
              "margin-bottom": "20px",
              "transition": "all .3s ease",
              "@media (max-width: 992px)": {
                "margin-bottom": "12px"
              }
            },
            ".mbr-contact": {
              "margin-bottom": "0",
              "padding-bottom": "6px",
              "transition": "all .3s ease",
              "@media (max-width: 992px)": {
                "padding-bottom": "4px"
              },
              "color": "#ddebfd"
            },
            ".copyright-container": {
              "display": "flex",
              "@media (max-width: 768px)": {
                "display": "block"
              },
              ".copyright-wrapper": {
                "width": "50%",
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                ".copyright": {
                  "margin-bottom": "20px"
                }
              },
              ".copyright-list": {
                "width": "50%",
                "@media (max-width: 768px)": {
                  "width": "100%"
                },
                "ul": {
                  "display": "inline-flex",
                  ".mbr-copy": {
                    "margin": "0 30px 0 0",
                    "transition": "all .3s ease"
                  }
                }
              }
            },
            ".item-wrap:hover, p:hover, .mbr-iconfont:hover": {
              "color": "@primaryColor"
            },
            ".mbr-section-title, .mbr-iconfont": {
              "color": "#ffffff",
              "line-height": "1.4"
            },
            ".copyright": {
              "color": "#000000"
            },
            ".list-copy": {
              "color": "#cbcbcb"
            },
            ".copyright, .copyright-list": {
              "color": "#b8b8b8"
            },
            ".mbr-section-subtitle, .social-wrapper": {
              "color": "#3575bd"
            }
          },
          "_name": "footer1",
          "_sourceTheme": "globalm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer1\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Main\" name=\"showMain\" checked>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" condition=\"showMain\">\n        <input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" condition=\"showMain\" checked>\n        <input type=\"checkbox\" title=\"List Title\" name=\"showListTitle\" condition=\"showMain\" checked>\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" condition=\"showMain\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" condition=\"showMain\" checked>\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"4\" step=\"1\" value=\"4\" condition=\"showMain\">\n        <input type=\"checkbox\" title=\"Copyright\" name=\"showCopyright\" checked>\n        <input type=\"checkbox\" title=\"Copyright List\" name=\"showCopyrightList\" condition=\"showCopyright\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#000000\" selected>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#124AD6\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row row-main\" mbr-if=\"showMain\">\n            <div class=\"col-12 col-lg-3 title\">\n                <div class=\"title-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/logo-ciprecon.svg\" alt=\"CIPRECON\" mbr-if=\"showLogo\">\n                    <h2 mbr-text class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title, .mbr-iconfont\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\"><br>Certificados en:<br><b>- ISO 9001:2008</b><br><b>- OHSAS 18000:2007</b></h2>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-4 card-list\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showListTitle\">\n                    <b>Ventas</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><a href=\"tel:+57-321 369-8204\" class=\"text-white\">(+57) 321 369-8204</a></li><li class=\"mbr-text item-wrap\"><a href=\"tel:+57-316-492-6687\" class=\"text-white\">(+57) 316 492-6687</a></li>\n                    <li class=\"mbr-text item-wrap\"><a href=\"tel:601-642-8911\" class=\"text-white\">(+57) 1 642-8911</a></li><li class=\"mbr-text item-wrap\"><a href=\"mailto:proyectos@ciprecon.com\" class=\"text-white\">proyectos@ciprecon.com</a></li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-4 card-list\">\n                <h5 mbr-text class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\" mbr-if=\"showListTitle\"><b>Puntos de venta</b></h5>\n                <ul class=\"list mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list\" data-multiline mbr-article>\n                    <li class=\"mbr-text item-wrap\"><a href=\"plantas-de-produccion.html#planta-prefabricados\" class=\"text-white\">• Planta Prefabricados</a></li><li class=\"mbr-text item-wrap\"><a href=\"plantas-de-produccion.html#planta-trituracion\" class=\"text-white\">• Planta Trituración</a></li><li class=\"mbr-text item-wrap\"><a href=\"plantas-de-produccion.html#punto-venta-postes-barranquilla\" class=\"text-white\">• Venta de Postes</a></li><li class=\"mbr-text item-wrap\"><a href=\"plantas-de-produccion.html#oficina-bogota\" class=\"text-white\">• Oficina Bogotá</a></li>\n                </ul>\n            </div>\n            <div class=\"col-12 col-lg-3 col-md-4\">\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle, .social-wrapper\" mbr-theme-style=\"display-4\" mbr-if=\"showListTitle\">\n                    <b>Horario</b></h5>\n                <p class=\"mbr-contact mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-contact\" mbr-if=\"showContacts\">\n                    Lunes - Viernes:&nbsp; &nbsp;8 AM - 5 PM<br></p>\n                <p class=\"mbr-contact mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".mbr-contact\" mbr-if=\"showContacts\">Sábados:&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;10 AM - 2 PM</p>\n                <div class=\"social-wrapper\">\n                    <div class=\"social-row display-7\" mbr-if=\"showSocial\">\n                        <div class=\"soc-item\">\n                            <a href=\"https://www.youtube.com/channel/UCNTkCvBdic6hReevwRrAcoQ\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-youtube socicon\" style=\"color: rgb(221, 235, 253); fill: rgb(221, 235, 253);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                            <a href=\"https://x.com/Ciprecon\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-twitter socicon\" style=\"color: rgb(221, 235, 253); fill: rgb(221, 235, 253);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                            <a href=\"https://www.instagram.com/ciprecon/\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-instagram socicon\" style=\"color: rgb(221, 235, 253); fill: rgb(221, 235, 253);\"></span>\n                            </a>\n                        </div>\n                        <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                            <a href=\"https://www.linkedin.com/company/ciprecon\" target=\"_blank\">\n                                <span mbr-icon class=\"mbr-iconfont socicon-linkedin socicon\" style=\"color: rgb(221, 235, 253); fill: rgb(221, 235, 253);\"></span>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\" mbr-if=\"showCopyright\">\n            <div class=\"col-12 copyright-container\">\n                <div class=\"copyright-wrapper\">\n                    <p class=\"mbr-fonts-style copyright\" mbr-theme-style=\"display-4\" data-app-selector=\".copyright, .copyright-list\" data-app-placeholder=\"Type Text\">© 2025 CIPRECON – Todos los derechos reservados</p>\n                </div>\n                <div class=\"copyright-list\" mbr-if=\"showCopyrightList\">\n                    <ul class=\"list list-copy mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".list-copy\" data-multiline mbr-article>\n                        <li class=\"mbr-copy item-wrap\"><a href=\"https://digital01.com\" class=\"text-primary\" target=\"_blank\">Designed by <b>01</b></a></li><li class=\"mbr-copy item-wrap\"><a href=\"politica-de-tratamiento-de-datos.html\" class=\"text-primary\">Política de tratamiento de datos</a></li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
